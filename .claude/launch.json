{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "services/memory-platform",
      "port": 8000
    },
    {
      "name": "backend-capture",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8010"
      ],
      "cwd": "services/memory-platform",
      "port": 8010
    },
    {
      "name": "frontend-capture",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "RME_API_TARGET=http://127.0.0.1:8010 npm run dev -- --port 5183 --strictPort"
      ],
      "cwd": "frontend",
      "port": 5183
    }
  ]
}
