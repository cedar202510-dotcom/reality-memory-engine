{
  "description": "通用场景物件查找：文本/图片至少给一个（图片为 base64 编码）。",
  "properties": {
    "query_text": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query Text"
