# 复制为 .env 后按需填写。全部留空 = FakeLLM 开箱即用。
DATABASE_URL=postgresql+asyncpg://rme:rme@localhost:5432/rme

LLM_PROVIDER=fake            # fake | openai | kimi-coding
LLM_BASE_URL=                # openai：任意 OpenAI 兼容端点
LLM_API_KEY=
LLM_VISION_MODEL=
LLM_TEXT_MODEL=
# LLM_TEMPERATURE=           # 可空：openai 默认 0.0；kimi-coding 默认 1.0（k3 只接受 1）

# kimi-coding：Kimi Code API（OpenAI 兼容，模型 k3 / k3-256k / kimi-for-coding）
KIMI_CODE_API_BASE_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=

EMBEDDING_BASE_URL=          # 留空 → 文本路降级 pg_trgm（CLIP 视觉路不受影响）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# CLIP 视觉检索：none 关闭 / local 本机 open_clip / http 边缘 sidecar / fake 演示
VISION_PROVIDER=none
VISION_MODEL=ViT-B-32
VISION_PRETRAINED=laion2b_s34b_b79k
# VISION_PREFER_HF_HUB=false # HF 不可达时权重走直链缓存
# VISION_BASE_URL=           # http：sidecar 地址
# VISION_API_KEY=

# 帧切片（区域级向量）：小物体（身份证/钥匙/遥控器）只在这里才有信号。
# 关掉的话，4000px 照片里的小物体缩到 CLIP 的 224 输入不足一个 patch，永远搜不到。
# 代价：每帧多 N 次 CLIP 编码（N ≤ VISION_TILE_MAX），走 outbox 异步，不阻塞摄入。
# VISION_TILING_ENABLED=true
# VISION_TILE_GRID=2         # 按短边切几份决定瓦片边长
# VISION_TILE_OVERLAP=0.25   # 相邻瓦片重叠比例（防物体被切缝劈开）
# VISION_TILE_MIN_SIDE=640   # 短边小于此值不切
# VISION_TILE_MAX=12         # 单帧瓦片数上限（成本封顶）

# 物件检测（开放词表）：给全览页每个节点配一张实拍缩略图。
# 拿这一帧抽出来的物品名当 prompt 出框，再按框裁一张小图落盘。关掉的话节点是纯色球。
# 需要可选依赖 transformers + 一次 ~1.4GB 权重下载（之后离线可用），本机推理不出网。
# 注意：裁切的输入是原始媒体，受 EVIDENCE_TTL_MINUTES 管辖——必须在原件被删之前跑完，
# 过期帧补不回来（缩略图本身另存一份，不随 TTL 删除）。
# DETECTOR_PROVIDER=none     # local | none
# DETECTOR_MODEL=google/owlv2-base-patch16-ensemble
# DETECTOR_SCORE_THRESHOLD=0.12  # OWLv2 分数整体偏低，0.1~0.2 是常用工作点
# DETECTOR_MAX_PROMPTS=8     # 单帧最多查几个物品名（一次前向，成本封顶）
# DETECTOR_DEVICE=           # 留空=自动（mps → cuda → cpu）
# CROP_PADDING=0.12          # 框外扩比例，给物体留一点呼吸空间
# CROP_SIZE=256              # 落盘缩略图边长

# OCR 文字识别：带字的小物体（身份证/银行卡/快递单/书脊/药盒）唯一能被搜到的方式。
# 它们的身份印在自己身上，OCR 命中的是字面量，不需要模型"认出"这是什么。
# 需要可选依赖 rapidocr（onnxruntime，纯 CPU，~50MB 权重），本机推理不出网。
# 输入同样受 EVIDENCE_TTL_MINUTES 管辖：必须赶在原件被删之前跑完。
OCR_PROVIDER=none            # local | fake | none
# OCR_MAX_SIDE=1600          # 识别前长边上限（比 VLM 的 1024 高：OCR 看的是笔画）
# OCR_MIN_SCORE=0.5          # 低于该置信度的文本块丢弃
# OCR_MAX_CHARS=2000         # 单帧文本长度上限（防菜单/说明书刷屏）
# ⚠️ OCR_REDACT_PII=true     # 关掉 = 身份证号/银行卡号明文长期留库，而原图 15 分钟后就删了。
#                            # 脱敏保留类型占位符（〔身份证号〕），检索照样能命中。

# 语音转写：none 关闭整条语音流水线 / http 走 asr-sidecar / fake 演示
# 前端「在场」页的麦克风输入也吃这套配置：none 时点「轻点说话」会明确报 503，不是静默失效
# sidecar 启动见 services/asr-sidecar/README.md
ASR_PROVIDER=none
ASR_BASE_URL=                # http：如 http://127.0.0.1:8100
ASR_API_KEY=                 # 与 sidecar 的 ASR_API_KEY 一致；留空则 sidecar 不校验
# ASR_TIMEOUT_SECONDS=60     # 音频转写较慢，默认 60s
ASR_LANGUAGE=                # 留空=自动检测。1-3s 短片段误判率高，中文部署应设 zh

# 原始媒体保留时长。15=隐私优先（采完即删，只留 caption/转写/向量）；
# 10080=7 天，能翻看和复用原始媒体，代价是所有采集都留在磁盘上。
EVIDENCE_TTL_MINUTES=15
CANDIDATE_ACCEPT_THRESHOLD=0.85
RETRIEVAL_TOP_K=8

# --- 语音问答（唤醒词 → 查记忆 → 念回耳朵，见 app/voice_qa/）---
VOICE_QA_ENABLED=true
# 唤醒词在转写之后识别，所以要把常见同音误转写一起列上（ASR 常把「小忆」听成「小意」）
VOICE_WAKE_WORDS=小忆,小意,小艺,小亿
VOICE_ANSWER_TTL_SECONDS=120

# --- 语音主动播报（信号 → 耳机，见 app/voice_delivery/）---
# 默认关闭：主动在人耳边说话是产品决定，不该因为装了这个模块就自动发生
VOICE_DELIVERY_ENABLED=false
VOICE_QUIET_HOURS=22:00-08:00   # 本机本地时间；留空 = 不设安静时段
VOICE_MAX_PER_HOUR=3            # 单设备每小时自动播报上限
VOICE_MIN_CONFIDENCE=0.6
VOICE_MESSAGE_TTL_SECONDS=300
