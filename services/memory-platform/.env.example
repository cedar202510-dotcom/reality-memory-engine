# 复制为 .env 后按需填写。全部留空 = FakeLLM 开箱即用。
DATABASE_URL=postgresql+asyncpg://rme:rme@localhost:5432/rme

LLM_PROVIDER=fake            # fake | openai | kimi-coding
LLM_BASE_URL=                # openai：任意 OpenAI 兼容端点
LLM_API_KEY=
LLM_VISION_MODEL=
LLM_TEXT_MODEL=
# LLM_TEMPERATURE=           # 可空：openai 默认 0.0；kimi-coding 默认 1.0（k3 只接受 1）

# kimi-coding：Kimi Code API（OpenAI 兼容，模型 k3 / k3-256k / kimi-for-coding）
KIMI_CODE_API_BASE_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=

EMBEDDING_BASE_URL=          # 留空 → 文本路降级 pg_trgm（CLIP 视觉路不受影响）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# CLIP 视觉检索：none 关闭 / local 本机 open_clip / http 边缘 sidecar / fake 演示
VISION_PROVIDER=none
VISION_MODEL=ViT-B-32
VISION_PRETRAINED=laion2b_s34b_b79k
# VISION_PREFER_HF_HUB=false # HF 不可达时权重走直链缓存
# VISION_BASE_URL=           # http：sidecar 地址
# VISION_API_KEY=

EVIDENCE_TTL_MINUTES=15
CANDIDATE_ACCEPT_THRESHOLD=0.85
RETRIEVAL_TOP_K=8
