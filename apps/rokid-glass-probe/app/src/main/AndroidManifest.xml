<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:label="Reality Glass Probe"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/AppTheme">
        <!-- singleTop：App 已在前台时，am start 带 capture_once 这类 extra 才会走
             onNewIntent。默认的 standard 模式下这条调试指令会被系统静默丢弃，
             而眼镜的输入通道会拦截 adb input tap，intent extra 是唯一可靠的脚本触发方式。 -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WearStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rokid.sprite.ACTION_TAKE_STATUS_CHANGED" />
                <action android:name="com.rokid.sprite.ACTION_LEG_STATUS_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>
</manifest>
