{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reality-memory.local/contracts/v1/capture-intent.schema.json",
  "title": "CaptureIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "capture_intent_id",
    "capture_session_id",
    "signal_kind",
    "occurred_at",
    "monotonic_start_ns",
    "monotonic_end_ns",
    "detector_rule_version",
    "intensity",
    "metrics",
    "requested_modalities"
  ],
  "properties": {
    "schema_ref": {
      "const": "rme.capture-intent.v1"
    },
    "capture_intent_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "capture_session_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "signal_kind": {
      "enum": [
        "HEAD_MOTION_TRANSITION",
        "WEAR_CONFIRMED",
        "USER_EXPLICIT",
        "VOICE_ACTIVITY",
        "DEBUG_TEST"
      ]
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/utcTime"
    },
    "monotonic_start_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "monotonic_end_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "detector_rule_version": {
      "type": "string"
    },
    "intensity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "STRONG"
      ]
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "requested_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/modality"
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
